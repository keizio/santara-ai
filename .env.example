# ---------- Database ----------
DATABASE_URL=postgres://santara:santara@localhost:5432/santara
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ---------- Sectors.app ----------
# https://sectors.app/api -> API key
SECTORS_API_KEY=
SECTORS_API_BASE_URL=https://api.sectors.app/v1
# When true (or when SECTORS_API_KEY is empty) the agents run against bundled
# fixture data so the whole pipeline is demoable without network access.
SECTORS_USE_FIXTURES=true

# ---------- LLM (Mastra agents) ----------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# When true (or when OPENAI_API_KEY is empty) agents fall back to deterministic
# rule-based reasoning instead of calling an LLM.
AGENTS_DETERMINISTIC_FALLBACK=true

# ---------- Telegram alerts ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERTS_ENABLED=false

# ---------- API / Web ----------
API_PORT=3001
API_CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
